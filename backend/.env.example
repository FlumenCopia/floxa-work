# ==============================================================================
# FLOXA WORK — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development or configure in your deployment vault.
# DO NOT COMMIT ACTUAL PRODUCTION CREDENTIALS OR SECRETS TO GIT.

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=5001
NODE_ENV=development # Options: development | test | staging | production
TRUST_PROXY=1 # Set to 1 when behind a reverse proxy / load balancer (e.g. NGINX, Cloudflare)

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MONGODB)
# ------------------------------------------------------------------------------
# For local dev: mongodb://127.0.0.1:27017/floxa_work_db
# For production: mongodb+srv://<user>:<password>@cluster.mongodb.net/floxa_work_prod?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/floxa_work_db
DB_MAX_POOL_SIZE=50
DB_MIN_POOL_SIZE=5
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_CONNECT_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & CRYPTOGRAPHIC SECRETS (MANDATORY IN PRODUCTION)
# ------------------------------------------------------------------------------
# In production, secrets must be cryptographically random strings (min 32 chars).
# Startup WILL FAIL in production if these are missing or set to default fallback strings.
JWT_ACCESS_SECRET=floxa_work_access_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=floxa_work_refresh_super_secret_jwt_key_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ------------------------------------------------------------------------------
# 4. CORS SECURITY HEADERS
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. https://floxa.work,https://app.floxa.work)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# 5. STORAGE ABSTRACTION (LOCAL DISK OR S3/CLOUDFLARE R2 COMPATIBLE)
# ------------------------------------------------------------------------------
# Options: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=media/private_vault/
MEDIA_ROOT=media/

# S3/R2 Configuration (Required if STORAGE_PROVIDER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=floxa-work-private-deliverables
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 6. EMAIL DELIVERY SERVICE
# ------------------------------------------------------------------------------
# Options: log (development) | smtp | sendgrid | resend
EMAIL_PROVIDER=log
EMAIL_FROM="FLOXA Work Notifications <no-reply@floxa.work>"
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 7. WEBRTC / TURN CONFIGURATION
# ------------------------------------------------------------------------------
# STUN/TURN server URLs for peer-to-peer audio/video call traversal across symmetric NATs
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & SECURITY OBSERVABILITY
# ------------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000
AUTH_RATE_LIMIT_MAX_REQUESTS=20
LOG_LEVEL=info # debug | info | warn | error
