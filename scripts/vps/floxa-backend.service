[Unit]
Description=FLOXA Work Backend API & WebSocket Engine
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=floxa
Group=floxa
WorkingDirectory=/var/www/floxa-work/backend
EnvironmentFile=/etc/floxa/backend.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=floxa-backend

# Security Sandboxing & Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/floxa-work/private_vault /var/www/floxa-work/backend
PrivateTmp=true
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
